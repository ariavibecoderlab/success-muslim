# ── Success Muslim — frontend environment ───────────────────
# Copy to ".env" for local dev. On Cloudflare Pages, set these as
# Build environment variables (Settings → Environment variables).
# These are PUBLIC values (the publishable/anon key is safe to ship
# in the client) — but never put the Supabase SERVICE ROLE key here.

# Your Supabase project ref (the subdomain of your project URL).
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Full Supabase API URL — https://<project-ref>.supabase.co
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase publishable (anon) key — Project Settings → API.
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Legacy aliases kept for compatibility with older code paths.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
